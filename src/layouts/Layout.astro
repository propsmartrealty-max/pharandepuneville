---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏛️</text></svg>" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Search & Crawl SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Pharande Puneville, Puneville Punawale, flats in Punawale, Aedas Puneville, luxury 2 BHK Punawale, 3 BHK Hinjawadi expressway, Pharande Spaces Pune, PCMC luxury townships, Punawale real estate" />
    <meta name="author" content="Pharande Spaces" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

    <!-- Geographic Microdata for Google Punawale Local Search -->
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content="Punawale, PCMC, Pune" />
    <meta name="geo.position" content="18.6325;73.7438" />
    <meta name="ICBM" content="18.6325, 73.7438" />

    <!-- Open Graph / Facebook / WhatsApp Preview -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Pharande Puneville" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Performance & Font Preconnects -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Syne:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Google Structured Microdata JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
  </head>

  <body class="bg-[#FAF7F2] text-[#0F172A] font-sans selection:bg-[#C59B27] selection:text-white antialiased overflow-x-hidden">
    <slot />
  </body>
</html>
