---
import Layout from '../layouts/Layout.astro';
import { Home, Phone, ArrowRight, Compass, ShieldCheck } from 'lucide-react';
---

<Layout 
  title="Page Not Found | Pharande Puneville Luxury Residences"
  description="The page you are looking for has moved or does not exist. Explore Pharande Puneville 28-acre Aedas-designed luxury township in Punawale, PCMC Pune."
  canonicalUrl="https://pharande-puneville.in/404"
>
  <div class="min-h-screen bg-[#0F172A] text-white flex flex-col justify-between relative overflow-hidden selection:bg-[#C59B27] selection:text-white">
    <!-- Ambient Edge Glows -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[#C59B27]/10 rounded-full blur-[140px] pointer-events-none" />
    <div class="absolute bottom-10 right-10 w-[400px] h-[400px] bg-blue-500/10 rounded-full blur-[120px] pointer-events-none" />

    <!-- Top Navigation Minimal Bar -->
    <header class="w-full py-6 px-4 sm:px-8 border-b border-white/10 relative z-10 flex items-center justify-between max-w-7xl mx-auto">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#C59B27] to-[#845D12] flex items-center justify-center font-display font-black text-white text-xl shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform">
          P
        </div>
        <div class="flex flex-col">
          <span class="font-display font-bold tracking-tight text-white text-base leading-tight">
            PHARANDE <span class="text-[#C59B27]">PUNEVILLE</span>
          </span>
          <span class="text-[10px] font-mono tracking-widest text-slate-400 uppercase">
            Punawale • PCMC Pune
          </span>
        </div>
      </a>

      <a 
        href="https://wa.me/917744009295?text=Hello%20Pharande%20Puneville%20Team%2C%20I%20need%20assistance%20regarding%20the%20project."
        target="_blank"
        rel="noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 text-xs font-bold hover:bg-emerald-500/30 transition-colors"
      >
        <Phone className="w-3.5 h-3.5" />
        <span>VIP Helpline: +91 7744009295</span>
      </a>
    </header>

    <!-- Main 404 Hero Content -->
    <main class="flex-1 flex items-center justify-center px-4 py-16 relative z-10">
      <div class="max-w-2xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-[#C59B27] text-xs font-mono font-bold uppercase tracking-wider mb-6">
          <Compass className="w-3.5 h-3.5" />
          <span>Error 404 • Cloudflare Edge Routing</span>
        </div>

        <h1 class="text-6xl sm:text-8xl font-display font-black tracking-tight text-white mb-4">
          4<span class="text-[#C59B27]">0</span>4
        </h1>

        <h2 class="text-2xl sm:text-3xl font-display font-bold text-slate-200 mb-4">
          Residences Horizon Not Found
        </h2>

        <p class="text-slate-400 text-sm sm:text-base leading-relaxed mb-10 max-w-lg mx-auto">
          The sanctuary or unit floorplan link you navigated to might have moved or been updated. Let our concierge guide you back to the masterplan.
        </p>

        <!-- Navigation Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-gradient-to-r from-[#C59B27] to-[#A87F18] text-white font-bold text-sm shadow-xl shadow-amber-500/20 hover:brightness-110 transition-all"
          >
            <Home className="w-4 h-4" />
            <span>Return to Masterplan</span>
          </a>

          <a
            href="/#residences"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 text-white font-bold text-sm border border-white/10 transition-colors"
          >
            <span>Explore 2 & 3 BHK Homes</span>
            <ArrowRight className="w-4 h-4" />
          </a>
        </div>

        <!-- Quick Landmark Links -->
        <div class="mt-14 pt-8 border-t border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-3 text-left">
          <a href="/#residences" class="p-3 rounded-xl bg-white/[0.03] border border-white/5 hover:border-amber-400/40 transition-colors block">
            <span class="text-xs font-bold text-white block">Residences</span>
            <span class="text-[11px] text-slate-400">2, 2.5 & 3 BHK Plans</span>
          </a>
          <a href="/#amenities" class="p-3 rounded-xl bg-white/[0.03] border border-white/5 hover:border-amber-400/40 transition-colors block">
            <span class="text-xs font-bold text-white block">Amenities</span>
            <span class="text-[11px] text-slate-400">Skywalk & 4 Pools</span>
          </a>
          <a href="/#location" class="p-3 rounded-xl bg-white/[0.03] border border-white/5 hover:border-amber-400/40 transition-colors block">
            <span class="text-xs font-bold text-white block">Location</span>
            <span class="text-[11px] text-slate-400">Near Expressway & IT Park</span>
          </a>
          <a href="/#construction" class="p-3 rounded-xl bg-white/[0.03] border border-white/5 hover:border-amber-400/40 transition-colors block">
            <span class="text-xs font-bold text-white block">Cluster D</span>
            <span class="text-[11px] text-slate-400">Wings Q, R, S Status</span>
          </a>
        </div>
      </div>
    </main>

    <!-- Footer Security Banner -->
    <footer class="w-full py-4 px-4 text-center border-t border-white/10 text-xs text-slate-400 flex flex-wrap items-center justify-center gap-4 relative z-10">
      <span class="inline-flex items-center gap-1.5">
        <ShieldCheck className="w-3.5 h-3.5 text-emerald-400" />
        MahaRERA: P52100000044
      </span>
      <span>•</span>
      <span>Pharande Puneville, Punawale PCMC Pune</span>
      <span>•</span>
      <span>Sales: +91 7744009295</span>
    </footer>
  </div>
</Layout>
